# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic (AI reading). Server-side only.
ANTHROPIC_API_KEY=
# Optional: claude-haiku-5-5 is cheaper. Default is claude-sonnet-5-5.
ANTHROPIC_MODEL=

# Supabase (accounts and saved data). From Supabase: Project Settings > API Keys / Data API.
# These two are safe to expose in the browser; row level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

PORT=8787
